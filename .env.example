# Copy to .env for local use, or set these in the Render dashboard.
# No real values belong in this file — it is committed.

# Meta Marketing API token. System user "Krishna" via app Gsheet2 (does not expire).
META_TOKEN=

# Branch.io Query API credentials (Branch dashboard -> Account -> Settings)
BRANCH_KEY=
BRANCH_SECRET=

# Optional password prompt. Left blank (the default) the dashboard is open to
# anyone with the URL. Set ADMIN_PASS to turn on a browser login.
ADMIN_USER=postly
ADMIN_PASS=

# Optional
CACHE_TTL=180

# ── History store (optional) ──
# Base URL of the ads-history Cloud Run service, and the bearer token it expects.
# The service holds the GCS credential; nothing Google-issued lives here, because the
# org policy forbids service-account keys and Render cannot do keyless Google auth.
# Leave HISTORY_URL blank and the dashboard behaves exactly as before: every day live.
HISTORY_URL=
HISTORY_TOKEN=
# Days before a day's numbers are treated as final. Meta bills late and Branch backfills
# late events, mostly within 48h; 3 clears both.
HISTORY_SETTLE_DAYS=3
